# Client-safe Supabase connection values
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only Supabase credential. Never prefix this with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Standalone Rezyn AI provider.
# auto = NVIDIA NIM when NVIDIA_API_KEY is present, otherwise local Ollama.
# ollama = always use local Ollama.
# nvidia = always use NVIDIA NIM.
REZYN_AI_PROVIDER=ollama

# Free local AI via Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
# Optional smaller/fallback model, for example qwen3:14b.
OLLAMA_FALLBACK_MODEL=
OLLAMA_NUM_CTX=65536

# Optional NVIDIA NIM cloud provider.
# Create a key from NVIDIA Build and keep it server-side only.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=poolside/laguna-xs-2.1

# Optional Drizzle migration connection string. Server/CLI only.
DATABASE_URL=

# Server-only Cashfree credentials.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
